<Window x:Class="FattureViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FattureViewer"
        xmlns:viewmodels="clr-namespace:FattureViewer.ViewModels"
        mc:Ignorable="d"
        Title="Visualizzatore Fatture" Height="750" Width="1200" WindowStartupLocation="CenterScreen"
        Background="#F5F6F8" FontFamily="Segoe UI" Icon="logo/logo100.png">

    <Window.Resources>
        <!-- Standard Light Button -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Importa ZIP" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" FontWeight="Bold"/>
                    
                    <!-- Menu 3 puntini -->
                    <Menu Background="Transparent" Margin="5" VerticalAlignment="Center">
                        <MenuItem Header="⋮" FontSize="18" FontWeight="Bold" Padding="5,0" Foreground="#333" BorderThickness="1" BorderBrush="#CCC" Background="White">
                            <MenuItem Header="Configura Regole..." Command="{Binding ConfigCommand}" FontSize="13"/>
                            <MenuItem Header="Svuota Database" Command="{Binding ClearCommand}" FontSize="13" Foreground="Red"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cerca Azienda:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchCompany, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Anno:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding FilterYear, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="60" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Mese:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding FilterMonth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="40" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView for Invoices -->
            <TreeView Grid.Column="0" 
                      ItemsSource="{Binding InvoiceTree}" 
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      Background="White"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      Margin="0,0,5,0">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type viewmodels:YearNode}" ItemsSource="{Binding Months}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📅 " />
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type viewmodels:MonthNode}" ItemsSource="{Binding Invoices}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📁 " />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#555"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:InvoiceNode}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📄 " />
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#000"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="5,2" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- Preview WebBrowser & XML -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                <TabControl Background="Transparent" BorderThickness="0" Margin="5">
                    <TabItem Header="Anteprima Documento" FontSize="14" FontWeight="SemiBold">
                        <WebBrowser local:WebBrowserHelper.Body="{Binding InvoiceHtmlContent}"/>
                    </TabItem>
                    <TabItem Header="Sorgente XML" FontSize="14" FontWeight="SemiBold">
                        <TextBox Text="{Binding InvoiceXmlContent, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="#FAFAFA" 
                                 Foreground="#333333" 
                                 BorderThickness="0" 
                                 FontFamily="Consolas" 
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Padding="10"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
