<Window x:Class="FattureViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FattureViewer"
        xmlns:viewmodels="clr-namespace:FattureViewer.ViewModels"
        mc:Ignorable="d"
        Title="Visualizzatore Fatture"
        Height="800"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        Icon="logo/logo100.png"
        Closed="MainWindow_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <DataTemplate x:Key="InvoiceWorkspaceTemplate">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TreeView Grid.Column="0"
                          ItemsSource="{Binding InvoiceTree}"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Background="White"
                          BorderBrush="#CCCCCC"
                          BorderThickness="1"
                          Margin="0,0,5,0">
                    <TreeView.Style>
                        <Style TargetType="{x:Type TreeView}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlatSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Style>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type viewmodels:YearNode}"
                                                  ItemsSource="{Binding Months}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="Calendario · " Foreground="#777"/>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#333"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type viewmodels:MonthNode}"
                                                  ItemsSource="{Binding Invoices}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="Mese · " Foreground="#777"/>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#555"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:InvoiceNode}">
                            <TextBlock Text="{Binding Name}"
                                       Margin="2"
                                       FontSize="12"
                                       Foreground="#000"/>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="5,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding FlatSearchResults}"
                         SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         Background="White"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Margin="0,0,5,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Style>
                        <Style TargetType="{x:Type ListBox}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlatSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayPartyName}"
                                           TextWrapping="Wrap"/>
                                <Border Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="6,2"
                                        CornerRadius="3"
                                        Background="#FFF3CD"
                                        Visibility="{Binding IsTemporary, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Temporanea"
                                               FontSize="11"
                                               Foreground="#7A5200"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Center"
                              Background="Transparent"/>

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TabControl Background="Transparent"
                                BorderThickness="0"
                                Margin="5">
                        <TabItem Header="Anteprima Documento"
                                 FontSize="14"
                                 FontWeight="SemiBold">
                            <WebBrowser local:WebBrowserHelper.Body="{Binding InvoiceHtmlContent}"/>
                        </TabItem>
                        <TabItem Header="Sorgente XML"
                                 FontSize="14"
                                 FontWeight="SemiBold">
                            <TextBox Text="{Binding InvoiceXmlContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="#FAFAFA"
                                     Foreground="#333333"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     Padding="10"/>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="{Binding ImportButtonText}"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontWeight="Bold"/>

                    <Menu Background="Transparent"
                          Margin="5"
                          VerticalAlignment="Center">
                        <MenuItem Header="⋮"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Padding="5,0"
                                  Foreground="#333"
                                  BorderThickness="1"
                                  BorderBrush="#CCC"
                                  Background="White">
                            <MenuItem Header="Imposta percorso Fatture Passive..."
                                      Command="{Binding SetPathCommand}"
                                      FontSize="13"/>
                            <MenuItem Header="{Binding ImportDatabaseMenuText}"
                                      Command="{Binding ImportDatabaseCommand}"
                                      FontSize="13"/>
                            <MenuItem Header="Imposta percorso database..."
                                      Command="{Binding SetDatabasePathCommand}"
                                      FontSize="13"/>
                            <Separator/>
                            <MenuItem Header="ADMIN..."
                                      Command="{Binding AdminCommand}"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                            <Separator/>
                            <MenuItem Header="{Binding VersionMenuText}"
                                      Command="{Binding VersionCommand}"
                                      FontSize="13"/>
                            <Separator/>
                            <MenuItem Header="{Binding ClearDatabaseMenuText}"
                                      Command="{Binding ClearCommand}"
                                      FontSize="13"
                                      Foreground="Red"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SearchLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchCompany, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             Width="160"
                             Margin="0,0,15,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="Anno:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox Text="{Binding FilterYear, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', Delay=200}"
                             Width="60"
                             Margin="0,0,15,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="Mese:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox Text="{Binding FilterMonth, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', Delay=200}"
                             Width="40"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#E3C46B"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,7"
                Margin="0,0,0,8"
                Visibility="{Binding IsSessionNoSaveEnabled, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Modalità di prova attiva: le nuove importazioni non verranno salvate."
                       Foreground="#7A5200"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0"
                        SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                        Background="#F5F6F8"
                        BorderBrush="#CCCCCC">
                <TabItem Header="Fornitori"
                         FontSize="15"
                         FontWeight="SemiBold"/>
                <TabItem Header="Clienti"
                         FontSize="15"
                         FontWeight="SemiBold"/>
            </TabControl>
            <ContentControl Grid.Row="1"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource InvoiceWorkspaceTemplate}"/>
        </Grid>
    </Grid>
</Window>
