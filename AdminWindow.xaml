<Window x:Class="FattureViewer.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADMIN" Height="560" Width="500" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F6F8" FontFamily="Segoe UI" Icon="logo/logo50.png">
    <Grid Margin="24">
        <Grid x:Name="LoginPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Accesso amministratore" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="1" Text="Inserisci la password ADMIN."
                       Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <PasswordBox x:Name="AdminPasswordBox" Grid.Row="2" Padding="8" FontSize="15"
                         HorizontalContentAlignment="Center" KeyDown="AdminPasswordBox_KeyDown"/>
            <TextBlock x:Name="LoginErrorText" Grid.Row="3" Text="Password errata."
                       Foreground="Red" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Button Content="Accedi" Width="110" Margin="0,18,10,0" Padding="8"
                        Background="#0078D7" Foreground="White" BorderThickness="0" Click="LoginButton_Click"/>
                <Button Content="Annulla" Width="110" Margin="0,18,0,0" Padding="8" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Impostazioni amministratore" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel>
                    <CheckBox x:Name="ZipImportCheckBox" Content="Abilita importazioni ZIP e database"
                              FontSize="15" VerticalContentAlignment="Center"/>
                    <Separator Margin="0,14"/>
                    <CheckBox x:Name="SessionNoSaveCheckBox"
                              Content="NON SALVATAGGIO IN SESSIONE"
                              FontSize="15"
                              FontWeight="SemiBold"
                              Foreground="#9A6700"
                              VerticalContentAlignment="Center"/>
                    <Separator Margin="0,14"/>
                    <CheckBox x:Name="AdminDeletionCheckBox"
                              Content="Abilita eliminazione manuale"
                              FontSize="15"
                              FontWeight="Bold"
                              Foreground="#B00020"
                              VerticalContentAlignment="Center"
                              Checked="AdminDeletionCheckBox_Checked"/>
                    <Border Background="#FFF0F0"
                            BorderBrush="#B00020"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,10,0,0">
                        <TextBlock Text="FUNZIONE RISERVATA: consente di eliminare singole fatture, mesi, anni o l'intera sezione dal database."
                                   Foreground="#B00020"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="2"
                       Text="NON SALVATAGGIO IN SESSIONE mostra normalmente le nuove fatture, ma usa soltanto un database temporaneo che viene eliminato alla chiusura dell'app."
                       Foreground="#666" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <TextBlock Grid.Row="3"
                       Text="La disattivazione delle importazioni blocca sia gli ZIP sia l'importazione diretta nei database."
                       Foreground="#666" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Salva" Width="110" Margin="0,18,10,0" Padding="8"
                        Background="#0078D7" Foreground="White" BorderThickness="0" Click="SaveButton_Click"/>
                <Button Content="Annulla" Width="110" Margin="0,18,0,0" Padding="8" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
