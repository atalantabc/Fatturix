<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\logo\logo.ico</ApplicationIcon>
    <Version>3.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app is published as a self-contained single file before this project is built. -->
    <EmbeddedResource Include="..\artifacts\app-win-x64\FattureViewer.exe">
      <LogicalName>FattureViewerInstaller.FattureViewer.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
