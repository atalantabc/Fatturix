<Window x:Class="FattureViewer.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sicurezza Database" Height="250" Width="350" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F6F8" FontFamily="Segoe UI" Icon="logo/logo50.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Titolo" FontSize="18" FontWeight="Bold" Foreground="#333" Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center"/>
        <TextBlock x:Name="DescText" Text="Descrizione" FontSize="13" Foreground="#666" Grid.Row="1" Margin="0,0,0,20" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

        <PasswordBox x:Name="PwdBox" Grid.Row="2" Padding="8" FontSize="14" Margin="0,0,0,20" HorizontalContentAlignment="Center"/>

        <TextBlock x:Name="ErrorText" Text="Password errata!" Foreground="Red" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OkButton" Content="Conferma" Width="100" Padding="8" Margin="0,0,10,0" Background="#0078D7" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Annulla" Width="100" Padding="8" Background="White" BorderBrush="#CCC" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
