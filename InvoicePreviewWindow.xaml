<Window x:Class="FattureViewer.InvoicePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FattureViewer"
        Title="Anteprima fattura"
        Width="1050"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        Icon="logo/logo50.png">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InvoiceTitle"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="4,0,4,10"
                   TextTrimming="CharacterEllipsis"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="4">
            <local:InvoiceViewerControl x:Name="Viewer"/>
        </Border>

        <Button Grid.Row="2"
                Content="Chiudi"
                Width="110"
                Padding="12,7"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
