<Window x:Class="FattureViewer.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor di Configurazione (config.txt)" Height="500" Width="800" WindowStartupLocation="CenterOwner"
        Background="#F5F5F5" FontFamily="Segoe UI">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Modifica le regole di routing:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            
            <!-- RichTextBox for Syntax Highlighting -->
            <RichTextBox x:Name="EditorBox" Grid.Row="1" FontFamily="Consolas" FontSize="14" 
                         TextChanged="EditorBox_TextChanged" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" BorderBrush="#CCC" BorderThickness="1"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Annulla" Width="100" Margin="0,0,10,0" Padding="5" Click="BtnCancel_Click"/>
                <Button Content="Salva" Width="100" Background="#4CAF50" Foreground="White" Padding="5" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>

        <!-- Legend Panel -->
        <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Legenda Comandi" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="EXTRACT_DIR" Foreground="Blue" FontWeight="Bold"/>
                    <TextBlock Text="Definisce la cartella temporanea base per l'estrazione." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="CREATE_DIR" Foreground="Blue" FontWeight="Bold"/>
                    <TextBlock Text="Crea una cartella se non esiste." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="COPY / MOVE" Foreground="Blue" FontWeight="Bold"/>
                    <TextBlock Text="Copia o sposta i file in base a un pattern." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>
                    
                    <TextBlock Text="TO" Foreground="Blue" FontWeight="Bold"/>
                    <TextBlock Text="Indica la cartella di destinazione per COPY o MOVE." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="RENAME" Foreground="Blue" FontWeight="Bold"/>
                    <TextBlock Text="Rinomina il file. Puoi usare le variabili." TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="Variabili supportate:" FontWeight="Bold" Margin="0,10,0,5"/>
                    <TextBlock Text="{}{filename} : Nome originale" FontSize="12"/>
                    <TextBlock Text="{}{year} : Anno fattura" FontSize="12"/>
                    <TextBlock Text="{}{month} : Mese fattura" FontSize="12"/>
                    <TextBlock Text="{}{day} : Giorno fattura" FontSize="12"/>
                    <TextBlock Text="{}{company} : Nome Azienda Destinataria" FontSize="12"/>

                    <TextBlock Text="Esempio:" FontWeight="Bold" Margin="0,15,0,5"/>
                    <TextBlock Text="{}COPY &quot;*.xml&quot; TO &quot;C:\Fatture&quot; RENAME &quot;{year}_{company}.xml&quot;" 
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="#EEE" Padding="5"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
